# ── Environment Variables ────────────────────────────────────────────────────
# Copy this file to .env and fill in values as needed.
# .env is gitignored — your secrets stay local.
#
# Only the LLM settings are needed. Everything else has sensible defaults
# in config.py that you can override here if you want.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ────────────────────────────────────────────────────────────
# Which LLM to use for generating answers. Options: "ollama" or "gemini"
# Default is "ollama" (local, free, no API key needed).
LLM_PROVIDER=ollama

# ── Gemini (only needed if LLM_PROVIDER=gemini) ─────────────────────────────
# Get a free API key from: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_api_key_here
